APP_NAME=Document Intelligence Platform
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/document_intelligence.db
CORS_ORIGINS=http://localhost:8000
ALLOWED_HOSTS=*
MAX_UPLOAD_PAGES=3
MAX_UPLOAD_SIZE_MB=15

# Phase 2 provider configuration. Never commit real keys.
OCR_PROVIDER=local
LLM_PROVIDER=not_configured
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
FINANCIAL_ABSOLUTE_TOLERANCE=1.00
FINANCIAL_RELATIVE_TOLERANCE=0.0001
